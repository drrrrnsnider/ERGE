{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    /* "node" is here for test helpers that read files from disk (the token
     * contrast checks). App code still runs in a browser and must not use Node
     * APIs — if you find yourself reaching for `fs` or `process` in a
     * component, that's the wrong layer, not a missing type. */
    "types": [
      "vite/client",
      "node",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Type safety — see docs/README.md for why these are on */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Import alias: "@/lib/api" means "src/lib/api".
     * Resolved relative to this file — `baseUrl` is deprecated and is removed
     * outright in TypeScript 7. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vitest.setup.ts"]
}
